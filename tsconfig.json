{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "compilerOptions": {
        "strict": true,
        "noEmit": true,
        "noUncheckedIndexedAccess": true,
        "paths": {
            "@admin/*": ["./resources/js/admin/*"]
        }
    },
    "include": ["resources/js/admin/**/*.ts", "resources/js/admin/**/*.vue"]
}
