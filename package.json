{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "lint": "eslint . --max-warnings=0",
        "format": "prettier --write resources/js/admin tests/e2e \"*.config.{js,ts}\" tsconfig.json",
        "type-check": "vue-tsc --noEmit && tsc --noEmit -p tests/e2e",
        "test": "vitest run",
        "format:check": "prettier --check resources/js/admin tests/e2e \"*.config.{js,ts}\" tsconfig.json",
        "e2e": "playwright test"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "1.63.0",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^24.19.1",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/test-utils": "^2.5.1",
        "@vue/tsconfig": "^0.9.1",
        "alpinejs": "^3.17.4",
        "concurrently": "^10.0.3",
        "eslint": "^10.12.0",
        "eslint-plugin-vue": "^10.11.1",
        "globals": "^17.13.0",
        "jsdom": "^30.1.2",
        "laravel-vite-plugin": "^3.1",
        "pinia": "^4.0.3",
        "prettier": "^3.9.9",
        "tailwindcss": "^4.0.0",
        "typescript": "~6.0",
        "typescript-eslint": "^8.71.1",
        "vite": "^8.0.0",
        "vitest": "^5.0.3",
        "vue": "^3.5.43",
        "vue-router": "^5.3.1",
        "vue-tsc": "^3.3.12"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    }
}
